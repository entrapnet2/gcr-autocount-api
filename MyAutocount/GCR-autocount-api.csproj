<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>GCR_autocount_api</RootNamespace>
    <AssemblyName>GCR-autocount-api</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AutoCount2.MainEntry" Version="2.2.26" />
    <PackageReference Include="AutoCount2.Sales" Version="2.2.26" />
    <PackageReference Include="AutoCount2.Purchase" Version="2.2.26" />
    <PackageReference Include="AutoCount2.Stock" Version="2.2.26" />
    <PackageReference Include="AutoCount2.ARAP" Version="2.2.26" />
    <PackageReference Include="AutoCount2.Invoicing" Version="2.2.26" />
    <PackageReference Include="AutoCount2.Inquiry" Version="2.2.26" />
    <PackageReference Include="AutoCount2.Accounting" Version="2.2.26" />
    <PackageReference Include="AutoCount2.Accounting.UI" Version="2.2.26" />
    <PackageReference Include="AutoCount2.UI" Version="2.2.26" />
    <PackageReference Include="AutoCount2.GST" Version="2.2.26" />
    <PackageReference Include="AutoCount2.Manufacturing" Version="2.2.26" />
    <PackageReference Include="AutoCount2.Tools" Version="2.2.26" />
    <PackageReference Include="AutoCount2.FinancialReport" Version="2.2.26" />
    <PackageReference Include="DevExpress.Utils" Version="22.2.7" />
    <PackageReference Include="Nancy" Version="2.0.0" />
    <PackageReference Include="Nancy.Hosting.Self" Version="2.0.0" />
    <PackageReference Include="Topshelf" Version="4.3.0" />
    <PackageReference Include="log4net" Version="2.0.17" />
  </ItemGroup>
  <ItemGroup>
    <None Include="App.config" />
    <Content Include="settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Auto-stamp assembly version from latest git tag (e.g. v1.0.3).
       Skipped when -p:Version=... is passed explicitly (CI uses that).
       SDK default Version is 1.0.0, so any other value means explicit.
       Tags are always x.y.z (enforced by release workflow); .0 is appended
       for the 4-part AssemblyVersion/FileVersion. -->
  <Target Name="SetVersionFromGitTag" BeforeTargets="GetAssemblyAttributes" Condition="'$(Version)' == '1.0.0'">
    <Exec Command="git describe --tags --abbrev=0" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitTagRaw" />
    </Exec>
    <PropertyGroup>
      <GitTagClean>$([System.String]::Copy('$(GitTagRaw)').Trim().TrimStart('v'))</GitTagClean>
      <GitTagClean Condition="'$(GitTagClean)' == ''">1.0.0</GitTagClean>
      <AssemblyVersion>$(GitTagClean).0</AssemblyVersion>
      <FileVersion>$(GitTagClean).0</FileVersion>
      <InformationalVersion>$(GitTagClean)</InformationalVersion>
    </PropertyGroup>
    <Message Text="Assembly version from git tag: $(GitTagClean)" Importance="high" />
  </Target>
</Project>